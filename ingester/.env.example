# Comma-separated symbols to track, e.g. BTC-USD,ETH-USD,SOL-USD.
# Stage 4 needs more than one partition actually carrying data for a rebalance test to
# prove anything — a single symbol leaves 5 of 6 partitions empty. See DECISIONS.md.
SYMBOLS=BTC-USD,ETH-USD,SOL-USD

# Kafka bootstrap server the ingester connects to.
# 127.0.0.1:29092 is the EXTERNAL listener, for running the ingester on the host via `npm run dev`.
# A containerized ingester on the compose network would use kafka:9092 instead.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
