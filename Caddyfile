# {$DOMAIN}: Caddy's own env-var substitution syntax — the real domain is supplied at
# deploy time (compose.deploy.yaml requires DOMAIN to be set, same mandatory-interpolation
# pattern already used for SYMBOLS/CORS_ORIGIN), never hardcoded here.
#
# Automatic TLS is Caddy's own default behavior for any site block with a real domain
# name — nothing below turns it on; it would need `tls internal` to turn it OFF. Caddy
# obtains and renews the certificate itself via ACME (ports 80 and 443 both need to
# reach this container from the public internet for that to work — see DECISIONS.md for
# the two separate layers, the Oracle security list and the instance's own iptables,
# that both have to allow it independently).
{$DOMAIN} {
	# Explicit, not left to Caddy's own default: reverse_proxy doesn't buffer by
	# default the way nginx does, but this is the one setting that would silently
	# break Stage 7's whole point (SSE deltas arriving live, not batched) if it were
	# ever wrong — CLAUDE.md's own "Always-on" note flagged exactly this risk ahead
	# of time. -1 means flush on every write, immediately. See DECISIONS.md.
	reverse_proxy api:8080 {
		flush_interval -1
	}
}
